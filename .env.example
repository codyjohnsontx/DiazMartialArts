# Every variable here is OPTIONAL. Copying this file to .env.local and running
# `npm run dev` boots the full public site with no further setup; the values
# below only turn on integrations that reach outside the site.

# Public site URL, used for canonical URLs, OpenGraph tags, and the sitemap.
# `npm run dev` falls back to http://localhost:3000 if this is blank, but
# `npm run build` requires it, so a working value ships here. Must be a full URL
# including protocol.
NEXT_PUBLIC_SITE_URL=https://diazmartialarts.vercel.app

# Base URL of the separate Diaz on Demand app, which owns member login and
# accounts. This is the ONLY place that destination is configured.
#
# The value below is a deliberate placeholder on the reserved .invalid TLD, which
# can never resolve. Replace it with the real URL once the Diaz on Demand app is
# deployed (for example the URL Vercel assigns it).
#
# While this is unset or still the placeholder, the site hides its member entry
# points rather than linking somewhere dead: the header and contact page drop the
# "Member Login" control, and /ondemand shows the coming soon page.
NEXT_PUBLIC_ONDEMAND_URL=https://replace-me.invalid

# Set true to show the Diaz on Demand "coming soon" page even once
# NEXT_PUBLIC_ONDEMAND_URL is set. Unset or false forwards visitors to the app.
ONDEMAND_COMING_SOON=false

# Public Google Calendar embed URL. Validated when set, but no page renders an
# embedded calendar today - /schedule links out to /announcements instead - so
# setting this changes nothing visitors see.
NEXT_PUBLIC_GOOGLE_CALENDAR_EMBED_URL=

# Public ICS feed URL for the /schedule upcoming events section. When it is set
# the feed is the source; unset or unreachable, the site falls back to the
# hand-maintained list in content/upcoming.ts.
NEXT_PUBLIC_GOOGLE_CALENDAR_ICS_URL=

# Public Formspree endpoint URL for contact form submissions. Without it the
# contact form renders but submissions are not delivered.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=
